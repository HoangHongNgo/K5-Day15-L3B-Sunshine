# Sao chép thành backend/.env (file này bị gitignore) rồi điền. KHÔNG commit, KHÔNG dán vào chat.
# Thiếu một trong hai dòng thì backend chạy chế độ cục bộ (dữ liệu trong backend/data/).
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase Dashboard -> Project Settings -> API Keys -> "Secret key" (bắt đầu bằng sb_secret_...).
# Khoá này bỏ qua RLS: ai có nó đọc/ghi được toàn bộ dữ liệu. Chỉ gửi cho thành viên nhóm qua kênh riêng.
SUPABASE_SERVICE_KEY=
