# File cấu hình môi trường DUY NHẤT ở gốc repo cho cả khung AI, backend và frontend.
# Chép thành .env rồi điền giá trị thật (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã chặn trong .gitignore). Không dán key vào code, slide, chat hay tiền tố VITE_*.

# ---------------- 1. Model AI (khung hackathon codebase/) ----------------
# MODEL_PROVIDER: codex (mặc định) / openai / gemini / anthropic / ollama / fake (chế độ giả)
# MODEL_NAME: mã gọi API của model (mặc định: 6.2-sol)
MODEL_PROVIDER=codex
MODEL_NAME=6.2-sol
API_KEY=

# ---------------- 2. VinUni Wayfinder Backend (Supabase & MegaLoc) ----------------
# Thiếu SUPABASE_URL hoặc SUPABASE_SERVICE_KEY thì backend tự chạy chế độ cục bộ (vinuni-wayfinder/backend/data/).
# Supabase Dashboard -> Project Settings -> API Keys -> "Secret key" (sb_secret_...). Khoá này bỏ qua RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# (Tuỳ chọn) Mật khẩu khởi tạo cho tài khoản quản trị trường (username: admin) trên cổng BTC (/clb).
# KHÔNG commit mật khẩu thật; để trống nếu chưa cần tự tạo tài khoản admin.
BTC_ADMIN_PASSWORD=

# (Tuỳ chọn) Đường dẫn cache trọng số MegaLoc tự chứa trong dự án:
# TORCH_HOME=vinuni-wayfinder/backend/.torch
# HF_HOME=vinuni-wayfinder/backend/.torch/hf
TORCH_HOME=
HF_HOME=

# (Chỉ chạy ở backend) Azure Speech nhận diện câu hỏi và đọc câu trả lời của mascot bằng tiếng Việt.
# AZURE_SPEECH_REGION là mã vùng dạng slug viết thường (vd: southeastasia, eastus).
# Tuyệt đối KHÔNG đặt tiền tố VITE_ để tránh lộ khoá ra trình duyệt.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------------- 3. VinUni Wayfinder Frontend (Vite dev server) ----------------
# Địa chỉ backend FastAPI để Vite dev proxy chuyển tiếp /api/* và /maps/*
WAYFINDER_BACKEND=http://127.0.0.1:8000

# (Chỉ chạy ở backend & Vite dev server) Khoá OpenAI cho hỏi đáp sự kiện (/api/events/{id}/ask) và tạo mascot 3D (/api/club-mascots/generate, /api/mascot/generate).
# Tuyệt đối KHÔNG đặt tiền tố VITE_ vì VITE_* sẽ bị đóng gói lộ ra trình duyệt.
OPENAI_API_KEY=
